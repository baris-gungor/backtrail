NODE_ENV=development
PORT=3000
# Interface to bind. Loopback by default; set 0.0.0.0 only behind a reverse proxy or tunnel.
HOST=127.0.0.1
# info: startup, signals, halts, warnings and errors. debug adds routine sync details.
LOG_LEVEL=info
# Per-request access log lines (errors are logged without it).
LOG_HTTP=false

# HTTP Basic Auth for the API, Swagger and the Vite dev server. Set both or neither.
# Empty = no auth (a warning is logged), which is refused when ALPACA_KEY_ID is set.
# Password: at least 8 characters.
AUTH_USERNAME=
AUTH_PASSWORD=

DB_HOST=localhost
DB_PORT=5434
DB_USER=fin_agent
DB_PASSWORD=fin_agent
DB_NAME=fin_agent
DB_LOGGING=false
# pgAdmin (docker compose --profile tools up -d). Required only for that profile.
# PGADMIN_EMAIL=you@example.com
# PGADMIN_PASSWORD=

# Sync all active assets once when the app starts
MARKET_DATA_SYNC_ON_STARTUP=true
# Initial backfill depth (Yahoo 1h history limit is ~730 days)
MARKET_DATA_HISTORY_DAYS=720
# Sync each asset shortly after its 1h bars close (continuous: hourly; US equities: :30 and 16:00 NY)
MARKET_DATA_SYNC_SCHEDULE=true
# Minutes after a bar close before the scheduled sync (max 25)
MARKET_DATA_SYNC_DELAY_MINUTES=5
# User-Agent for SEC EDGAR requests (earnings dates of US equities). SEC asks for a name and a
# contact, e.g. "backtrail you@example.com". Empty: a generic name is sent.
SEC_USER_AGENT=

# Alpaca demo (paper) account for 'alpaca_paper' portfolios. Leave the keys empty to disable.
# Only the paper endpoints are accepted; the app refuses to start with a live URL.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_STREAM_URL=wss://paper-api.alpaca.markets/stream
# Telegram notifications: new signals on the latest bar, filled orders, kill switch.
# Create a bot with @BotFather, message it once, then read chat.id from
# https://api.telegram.org/bot<token>/getUpdates. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Language of the notification texts: tr or en.
NOTIFY_LOCALE=tr

# Minutes between broker/DB reconciliations (0 = only after fills and on demand)
ALPACA_RECONCILE_MINUTES=15
